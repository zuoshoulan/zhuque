# 朱雀广告平台 - 环境变量配置示例
# 复制此文件为 .env.dev 或 .env.prod，并修改相应的值

# ========================================
# 应用配置
# ========================================
SPRING_PROFILES_ACTIVE=dev

# ========================================
# 数据库配置
# ========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhuque_dev
MYSQL_USER=root
MYSQL_PASSWORD=root

# ========================================
# Redis配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ========================================
# JWT配置
# ========================================
# 注意：生产环境必须使用强密码，至少32位
JWT_SECRET=zhuque-jwt-secret-key-change-in-production-environment
JWT_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000

# ========================================
# OSS对象存储配置
# ========================================
OSS_TYPE=local
# 本地存储
OSS_LOCAL_PATH=/data/zhuque/upload/
# 阿里云OSS（生产环境）
# OSS_TYPE=aliyun
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET_NAME=zhuque-prod
# MinIO（测试环境）
# OSS_TYPE=minio
# OSS_ENDPOINT=http://localhost:9000
# OSS_ACCESS_KEY_ID=minioadmin
# OSS_ACCESS_KEY_SECRET=minioadmin
# OSS_BUCKET_NAME=zhuque

# ========================================
# 文件上传配置
# ========================================
FILE_UPLOAD_PATH=/data/zhuque/upload/
FILE_MAX_SIZE=10MB
FILE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ========================================
# CORS跨域配置
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO
LOG_PATH=/data/logs/zhuque/

# ========================================
# 监控配置
# ========================================
MANAGEMENT_ENDPOINTS_HEALTH_SHOW_DETAILS=when-authorized
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# ========================================
# 其他配置
# ========================================
# 时区
TZ=Asia/Shanghai

# 应用名称
APP_NAME=zhuque-admin

# 应用版本
APP_VERSION=2.0.0
